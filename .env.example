# Copy to .env.local and fill in what you need. Everything is optional:
# without these the site runs fully in demo mode.

# Public URL used for canonical links, sitemap and Open Graph tags.
NEXT_PUBLIC_SITE_URL=https://www.shitalmotors.com

# ── Shital Assist (AI chatbot) ────────────────────────────────────────────────
# With a key, the assistant uses Claude, grounded in the site's content.
# Without one, it uses the built-in rule-based demo engine.
ANTHROPIC_API_KEY=
# Optional model override (defaults to claude-opus-5-5).
ASSISTANT_MODEL=

# ── Lead delivery (test drive, price, service, contact, careers) ─────────────
# Each validated lead is POSTed as JSON to this URL (CRM, DMS, Zapier/Make,
# Google Apps Script, Slack workflow…). Without it, leads are logged on the
# server only and visitors are told the site is in demo mode.
LEAD_WEBHOOK_URL=
# Sent as the `x-lead-secret` header so the receiver can verify the source.
LEAD_WEBHOOK_SECRET=
